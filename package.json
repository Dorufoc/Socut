{
  "name": "focusnews",
  "version": "0.1.0",
  "description": "离线广播级新闻字幕条（Lower Third）生成与透明 MOV / MP4 叠加导出工具",
  "main": "out/main/index.js",
  "author": "FocusNews",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:env": "node scripts/check-env.mjs",
    "verify": "npm run check:env && npm run lint && npm run typecheck && npm run test",
    "verify:all": "node scripts/verify-all.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "make:fixtures": "node scripts/make-probe-fixtures.mjs",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win x64",
    "package:win": "node scripts/package-win.mjs",
    "dist:win": "node scripts/dist-win.mjs",
    "dist:cache": "node scripts/dist-win.mjs --dir",
    "verify:packaged": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify-packaged.ps1",
    "dist:dir": "npm run build && electron-builder --dir",
    "smoke": "node scripts/smoke-export.mjs",
    "visual:check": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yoga-layout": "3.2.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
